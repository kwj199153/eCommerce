# ============================================================
#  docker compose 的变量插值源
# ------------------------------------------------------------
#  ★ 关键：compose 只读**本目录**的 `.env`，**不读** backend/.env。
#    两份 .env 服务于两个不同的读取方，别混淆：
#      · 本文件  → docker-compose.yml 里 ${VAR} / ${VAR:-default} 的取值来源
#      · backend/.env → 应用进程（pydantic Settings）的配置来源
#
#  用法：
#    cp .env.example .env        # 仅生产需要；本地开发**可以不建**
#    docker compose up -d --build
#
#  ★ 本地开发可以完全不建这个文件：compose 里每个变量都带默认值
#    （形如 ${POSTGRES_PASSWORD:-...}），不设 = 沿用原有行为，「一键起」照旧。
#
#  ★ 生产环境必须设置。backend/core/config.py 在 environment=production 时
#    会做启动期硬校验：若数据库连接串仍是默认/弱口令，**拒绝启动**
#    （不是告警，是起不来）—— 因为「库对公网开着 + 口令是默认值」这件事
#    一旦上线，不会有任何报错，只会被扫到。
# ============================================================

# ---- 数据库账号（postgres 服务初始化用；仅首次建库时生效）----
POSTGRES_USER=kevin
POSTGRES_DB=postgres

# ---- ★ 生产必填：高强度随机口令 -------------------------------
#  不设/留空 ⇒ 回落到 compose 里的默认值（仅供本地）。
#  ★ 改这里之后**必须同步下面的 DATABASE_URL**：
#    两处口径不一致时 compose 照常起、容器却连不上库，
#    现象是「backend 一直重启但看不出原因」。
#    （backend/scripts/check_compose_secrets.py 会把这条不一致判为 FAIL）
POSTGRES_PASSWORD=

# ---- 容器内连接串 --------------------------------------------
#  用户名/口令必须与上面的 POSTGRES_USER / POSTGRES_PASSWORD 一致；
#  主机名必须是 compose 服务名 `postgres`（不是 localhost）。
#  不设 ⇒ 回落默认值（与上面 POSTGRES_* 的默认值同源）。
# DATABASE_URL=postgresql+asyncpg://kevin:<你的口令>@postgres:5432/postgres

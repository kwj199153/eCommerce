# ====== 应用配置 ======
APP_NAME=跨境电商AI SaaS
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ====== 服务器 ======
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ====== 数据库 (PostgreSQL) ======
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ====== Redis & Celery ======
# ⚠️ 用 127.0.0.1 而不是 localhost：Windows 上 localhost 先解析到 IPv6 的 ::1，
#    若 Redis 只监听 IPv4，连接被拒绝且要等约 2s；带 connect timeout 的客户端
#    会在超时处放弃而不回退 IPv4 ⇒ 限流后端静默降级成进程内计数。
# ★ 口令哈希轮数（bcrypt 成本因子）：生产必须 >=12，启动护栏会拒绝更小的值。
#   测试提速不要改这里（本文件同时被开发服务读取），改用 tests/conftest.py 的会话级覆盖。
# PASSWORD_HASH_ROUNDS=12

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
# 注意：result backend 只用于排查，**不是任务状态源**（result_expires=3600，1 小时后蒸发）。
# 任务状态的权威源是 PostgreSQL 表 aigc_jobs，见 modules/aigc_media/job_service.py。

# ====== Celery Worker（仅 worker.py 进程读取）======
# 指标/健康端口；0 = 关闭。未鉴权，只绑回环，不要对公网开放。
WORKER_METRICS_PORT=9100
WORKER_METRICS_HOST=127.0.0.1
# 执行池。默认 threads：任务指标注册表是进程内的，prefork 下子进程的计数
# 不会出现在 /metrics 里（会显示成 0）。CPU 密集场景可改 prefork。
WORKER_POOL=threads
WORKER_CONCURRENCY=4
# WORKER_NODE_NAME=worker1@%h

# ====== AIGC 异步任务 ======
# 同一用户同时进行中（pending/running）的任务数上限；超出返回 429。
# 存在的意义：出图按张计费，防止连点/脚本刷出「钱花了但队列堵死」。
AIGC_MAX_INFLIGHT_PER_USER=3

# ====== JWT 认证 ======
# ====== 静态加密（店铺平台凭证 + 本机登录凭据）======
# 用途（两处，共用同一把密钥）：
#   ① stores_store.api_credentials —— 店铺平台凭证
#   ② auth:device:<device_id>      —— 本机免密切换的登录凭据（服务端加密托管）
#
# ★ 环境变量名是**历史命名**（先有店铺凭证那个场景），实际已升格为
#   通用静态加密主密钥。此处刻意不改名：改名会让已部署环境的配置静默失效。
# ★ 共用一把密钥的已知后果：轮换它会让两类密文同时失效。
#   本机免密对此**优雅降级**（删掉解不开的条目 ⇒ 用户重新登录一次即可重建），
#   不报错、不静默。
#
# 生成（一次性）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# 留空 = **拒绝写入**（不是明文落库）。具体后果：
#   · 平台凭证：真去连接平台时才失败，原因可读
#   · 本机免密：POST /auth/device/enroll 回 503，切换账号需输密码
# ★ 不要为了「先跑起来」而自动生成密钥 —— 见上方「比明文更坏」那条。
# ★ 因此本项**不列入**启动硬拒绝：暂不接平台是合法状态，不该起不来。
SHOP_CREDENTIALS_ENCRYPTION_KEY=

JWT_SECRET_KEY=your-super-secret-key-change-in-production-must-be-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====== LLM (DashScope/Qwen) ======
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_DEFAULT_MODEL=qwen-max
LLM_FALLBACK_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
# LLM Base URL（默认 DashScope，可替换为 OpenAI 兼容端点）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ====== RAG 配置 ======
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ====== 限流 & 计费 ======
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=1000
FREE_TIER_MONTHLY_QUOTA=100
# 请求速率限制中间件开关（按客户端 IP 固定窗口计数；压测/调试时可临时关掉）
RATE_LIMIT_ENABLED=true
# 访问日志中间件开关（生成 X-Request-ID / X-Process-Time-Ms）
REQUEST_LOG_ENABLED=true

# ====== 文件存储 ======
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf","csv","xlsx","txt","json","jpg","png"]

# ====== 对外可访问地址（公网回源）======
# 用于生成「第三方服务能回源拉取」的资源 URL。目前消费方：声音复刻（CosyVoice）。
# CosyVoice 的 input.url 必须是公网可访问地址（服务端主动拉取，不接受上传流），
# 所以 /static/voice/xxx.wav 需要靠这个前缀变成公网 URL。
# ⚠️ 不能填 localhost —— 外网取不到。本地联调请用内网穿透或已部署环境。
# 留空 = 未配置 → 语音克隆会显式报错说明原因（不静默退回 localhost）。
PUBLIC_BASE_URL=

# ====== 支付网关（订阅计费）======
#
# PAYMENT_GATEWAY 决定走哪个实现（见 core/config.py::Settings.payment_gateway）：
#   mock    —— 模拟支付，**无条件返回成功**。仅限开发/演示环境。
#   alipay  —— 支付宝当面付（扫码支付），已完整接入。
#
# ⚠️ environment=production 时以下每条都会被**启动期强制校验**，不满足直接拒绝启动：
#      · PAYMENT_GATEWAY=mock                -> 拒（否则用户点一下就成了付费用户，一分钱不收）
#      · PAYMENT_GATEWAY=stripe/wechat/...   -> 拒（占位名，实现还没写）
#      · PAYMENT_GATEWAY=alipay 但缺凭证/回调 -> 拒（否则每一笔支付都"看起来像支付宝那边出了问题"）
#    开发环境（environment=development）不校验，保持默认 mock 即可。
PAYMENT_GATEWAY=mock

# ---- 支付宝当面付（PAYMENT_GATEWAY=alipay 时必填）----
# APPID：开放平台应用详情页。
PAYMENT_ALIPAY_APP_ID=
# 应用私钥（PKCS#8，用于**请求签名**）。
# ⚠️ .env 里必须写成**一行**，换行用字面量 \n 转义：
#     PAYMENT_ALIPAY_APP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
#     （也可以直接贴密钥工具里复制出的纯 base64，两种形态都认）
PAYMENT_ALIPAY_APP_PRIVATE_KEY=
# 支付宝公钥（用于**回调验签**）。
# ⚠️ 是「支付宝公钥」，**不是**「应用公钥」。用错的表现是"每一条回调都验签失败"，
#    极易被误读成"支付宝在乱发通知"。
PAYMENT_ALIPAY_PUBLIC_KEY=
# 网关地址。沙箱联调改成 https://openapi-sandbox.dl.alipaydev.com/gateway.do
PAYMENT_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# ---- 支付回调地址 ----
# 留空 = 由 PUBLIC_BASE_URL 派生（推荐）：<PUBLIC_BASE_URL>/api/v1/billing/webhook/alipay
# ⚠️ 支付宝**只会**原样拿这个字符串去发 HTTP 请求，所以：
#    · 必须是**绝对 URL**（带 http:// 或 https://）—— 写成 api.example.com/... 不会报错，
#      只会让回调发到一个不存在的主机，而这一侧什么日志都看不到；
#    · 生产必须 **https**，且公网可达（安全组要放行 443，回调是支付宝主动入站）。
# 两者都为空 ⇒ 生产环境拒绝启动（收不到回调就永远不会激活订阅）。
PAYMENT_NOTIFY_URL=
# 支付完成后跳回的前端页面（仅展示引导用）。
# ★ 当前**无任何消费点**（当面付是扫码，不需要 return_url）—— 留空即可。
#   写进本样例是为了让运维知道它存在，而不是暗示它有用。
PAYMENT_RETURN_URL=

# ---- 微信支付（尚未接入）----
# 计划形态：**Native 支付（扫码）**，与支付宝当面付同构（PC 站点 + 已有扫码弹窗，
#   下单拿 code_url 直接复用现有二维码渲染链路）。
# 当前把 PAYMENT_GATEWAY 配成 wechat / wechatpay 会被启动期拒绝
#   （KNOWN_UNIMPLEMENTED_GATEWAYS 是占位名清单）—— 这是**有意**的：
#   静默回落 mock 会让"配了真实网关"和"什么都没配"看起来一模一样。
# ⚠️ 但**拼错的名字**（如 alipya / wechat_pay）**不会**被启动期拦住 ——
#   它不落在护栏的任何一支里，会一路放行到 get_gateway()，
#   在**第一笔支付**那一步才抛 ValueError。⇒ 改这个名字时请逐一核对上两份清单。
# ⇒ 接入完成前不要在这里填微信的任何配置项。

# ====== 附加模块（可插拔）======
# 语音克隆（客服音色）。默认 false：装了也不生效，必须显式打开。
# 关闭时：前端「客服语音」Tab 隐藏 + 后端 /api/v1/voice-clone 路由不注册（404）；数据表保留不删。
# ⚠️ 前端侧开关：frontend/.env.local 的 VITE_VOICE_CLONE_ENABLED，两者需一起打开。
VOICE_CLONE_ENABLED=false

# ====== 鉴权（两个**独立**开关，别搓成一个）======
#
# AUTH_REQUIRED —— **匿名**访问放不放行（请求完全不带 Authorization 头时才看它）：
#   True （默认，生产）= 要求 Bearer Token，未登录 401
#   False              = 本地匿名联调放行
#
# DEMO_MODE —— 是否承认前端那条演示哨兵串 `demo-token` 为「匿名演示身份」：
#   True  = 本地演示模式（须与 frontend/.env.local 的 VITE_DEMO_MODE=true 配对）
#   False （默认）= 不认它。生产必须为 false，启动护栏会拒绝 true
#
# ★ 为什么是两个开关（2026-09-17 修复「真实登录后仍看到别人的 4 个店铺」时拆开）：
#   此前「演示模式」被表达成「AUTH_REQUIRED=false 就连 token 都不解析」，
#   于是**真实登录的用户也拿不到身份** ⇒ 店铺归属过滤整体失效（越权可见）。
#   正确语义是：带了真 token 就**必须**解析出身份；开关只决定"没有身份时怎么办"。
#
# ⚠️ 四象限都有确定行为，不存在「漏配即静默放行」：
#   AUTH_REQUIRED=true  + DEMO_MODE=false → 生产（推荐）
#   AUTH_REQUIRED=false + DEMO_MODE=true  → 本地演示（无凭据 / demo-token 均放行）
#   AUTH_REQUIRED=false + DEMO_MODE=false → 本地真登录联调（匿名放行，真 token 必解析）
#   AUTH_REQUIRED=true  + DEMO_MODE=true  → 拒绝启动（配置矛盾，护栏拦截）
AUTH_REQUIRED=false
DEMO_MODE=true

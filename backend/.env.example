# ====== 应用配置 ======
APP_NAME=跨境电商AI SaaS
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ====== 服务器 ======
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ====== 数据库 (PostgreSQL) ======
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ====== Redis & Celery ======
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ====== JWT 认证 ======
JWT_SECRET_KEY=your-super-secret-key-change-in-production-must-be-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====== LLM (DashScope/Qwen) ======
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_DEFAULT_MODEL=qwen-max
LLM_FALLBACK_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
# LLM Base URL（默认 DashScope，可替换为 OpenAI 兼容端点）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ====== RAG 配置 ======
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ====== 限流 & 计费 ======
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=1000
FREE_TIER_MONTHLY_QUOTA=100
# 请求速率限制中间件开关（按客户端 IP 固定窗口计数；压测/调试时可临时关掉）
RATE_LIMIT_ENABLED=true
# 访问日志中间件开关（生成 X-Request-ID / X-Process-Time-Ms）
REQUEST_LOG_ENABLED=true

# ====== 文件存储 ======
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf","csv","xlsx","txt","json","jpg","png"]

# ====== 对外可访问地址（公网回源）======
# 用于生成「第三方服务能回源拉取」的资源 URL。目前消费方：声音复刻（CosyVoice）。
# CosyVoice 的 input.url 必须是公网可访问地址（服务端主动拉取，不接受上传流），
# 所以 /static/voice/xxx.wav 需要靠这个前缀变成公网 URL。
# ⚠️ 不能填 localhost —— 外网取不到。本地联调请用内网穿透或已部署环境。
# 留空 = 未配置 → 语音克隆会显式报错说明原因（不静默退回 localhost）。
PUBLIC_BASE_URL=

# ====== 附加模块（可插拔）======
# 语音克隆（客服音色）。默认 false：装了也不生效，必须显式打开。
# 关闭时：前端「客服语音」Tab 隐藏 + 后端 /api/v1/voice-clone 路由不注册（404）；数据表保留不删。
# ⚠️ 前端侧开关：frontend/.env.local 的 VITE_VOICE_CLONE_ENABLED，两者需一起打开。
VOICE_CLONE_ENABLED=false

# 业务接口强制鉴权（False=演示模式放行 / True=生产模式要求 Bearer Token）
# 生产环境务必设为 true，否则业务接口任何人都能访问
AUTH_REQUIRED=false

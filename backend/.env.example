# ====== 应用配置 ======
APP_NAME=跨境电商AI SaaS
APP_VERSION=0.1.0
DEBUG=true
ENVIRONMENT=development

# ====== 服务器 ======
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ====== 数据库 (PostgreSQL) ======
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ecommerce
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ====== Redis & Celery ======
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ====== JWT 认证 ======
JWT_SECRET_KEY=your-super-secret-key-change-in-production-must-be-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====== LLM (DashScope/Qwen) ======
DASHSCOPE_API_KEY=your-dashscope-api-key-here
LLM_DEFAULT_MODEL=qwen-max
LLM_FALLBACK_MODEL=qwen-plus
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=120
# LLM Base URL（默认 DashScope，可替换为 OpenAI 兼容端点）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ====== RAG 配置 ======
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=5

# ====== 限流 & 计费 ======
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_DAY=1000
FREE_TIER_MONTHLY_QUOTA=100

# ====== 文件存储 ======
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=["pdf","csv","xlsx","txt","json","jpg","png"]
